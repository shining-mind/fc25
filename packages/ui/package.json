{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cem analyze && vite build && tsc --project ./tsconfig.build.json && lit-analyzer",
    "preview": "vite preview",
    "storybook": "concurrently -kr \"cem analyze --watch\" \"storybook dev -p 6006\"",
    "build-storybook": "cem analyze && storybook build",
    "analyze": "cem analyze"
  },
  "dependencies": {
    "lit": "3.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.1",
    "@custom-elements-manifest/analyzer": "0.10.8",
    "@storybook/addon-a11y": "9.1.8",
    "@storybook/addon-docs": "9.1.8",
    "@storybook/addon-vitest": "9.1.8",
    "@storybook/web-components-vite": "9.1.8",
    "@vitest/browser": "3.2.4",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.1",
    "glob": "11.0.3",
    "playwright": "1.55.1",
    "sass-embedded": "1.93.2",
    "storybook": "9.1.8",
    "ts-lit-plugin": "2.0.2",
    "typescript": "5.8.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "files": [
    "dist/",
    "src/styles/**/*.scss",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/components/**/*.js"
  ],
  "exports": {
    "./utils.js": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./components/fc25-accordion.js": {
      "types": "./dist/components/fc25-accordion/index.d.ts",
      "default": "./dist/components/fc25-accordion/index.js"
    },
    "./styles/normalize.js": {
      "types": "./dist/styles/normalize/index.d.ts",
      "default": "./dist/styles/normalize/index.js"
    },
    "./scss/*.scss": {
      "sass": "./src/styles/*.scss"
    }
  },
  "customElements": "custom-elements.json"
}